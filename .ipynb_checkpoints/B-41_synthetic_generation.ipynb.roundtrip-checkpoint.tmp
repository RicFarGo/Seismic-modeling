  {
   "cell_type": "markdown",
   "id": "f6de8760",
   "metadata": {},
   "source": [
    "## Legacy section disabled"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "754fae68",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Muestras ondicula: 65\n",
      "Duracion ondicula: 128.0 ms, dt: 2.0 ms\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 600x300 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Legacy cell disabled.\n",
    "\n",
    "# Eje temporal de la ondicula (centrado en 0)\n",
    "half_len_ms = wavelet_length_ms / 2.0\n",
    "tw_ms = np.arange(-half_len_ms, half_len_ms + dt_conv_ms, dt_conv_ms)\n",
    "tw_s = tw_ms / 1000.0\n",
    "\n",
    "# Ondicula de Ricker\n",
    "pi2f2t2 = (np.pi**2) * (f0_hz**2) * (tw_s**2)\n",
    "ricker = (1.0 - 2.0 * pi2f2t2) * np.exp(-pi2f2t2)\n",
    "\n",
    "# Normalizar amplitud maxima a 1\n",
    "max_abs = np.max(np.abs(ricker))\n",
    "if max_abs > 0:\n",
    "    ricker = ricker / max_abs\n",
    "\n",
    "print(f\"Muestras ondicula: {len(ricker)}\")\n",
    "print(f\"Duracion ondicula: {wavelet_length_ms:.1f} ms, dt: {dt_conv_ms:.1f} ms\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 3))\n",
    "ax.plot(tw_ms, ricker, color=\"firebrick\", linewidth=1.5)\n",
    "ax.axhline(0, color=\"black\", linewidth=0.8)\n",
    "ax.set_xlabel(\"Tiempo (ms)\")\n",
    "ax.set_ylabel(\"Amplitud\")\n",
    "ax.set_title(\"Ondicula Ricker (20 Hz)\")\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
