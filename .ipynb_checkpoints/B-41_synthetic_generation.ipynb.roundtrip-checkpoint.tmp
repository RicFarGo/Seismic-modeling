   "source": [
    "# Legacy cell disabled.\n",
    "\n",
    "ia_next = resampled_logs_twt[\"IA\"].shift(-1)\n",
    "ia_curr = resampled_logs_twt[\"IA\"]\n",
    "denom = ia_next + ia_curr\n",
    "\n",
    "# Evitar division por cero y propagar NaN cuando falten datos\n",
    "resampled_logs_twt[\"RC\"] = np.where(\n",
    "    np.isfinite(ia_next) & np.isfinite(ia_curr) & np.isfinite(denom) & (denom != 0),\n",
    "    (ia_next - ia_curr) / denom,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "ia_valid = np.isfinite(resampled_logs_twt[\"IA\"]).sum()\n",
    "rc_valid = np.isfinite(resampled_logs_twt[\"RC\"]).sum()\n",
    "\n",
    "print(f\"Valores validos IA: {ia_valid:,}\")\n",
    "print(f\"Valores validos RC: {rc_valid:,}\")\n",
    "print(f\"Ultimo RC (esperado NaN): {resampled_logs_twt['RC'].iloc[-1]}\")\n",
    "\n",
    "resampled_logs_twt[[\"TWT_MS_REG\", \"RHOB\", \"VEL_FROM_SONIC_MPS\", \"IA\", \"RC\"]].head(12)"
   ]
  },
