   "source": [
    "# Legacy cell disabled.\n",
    "\n",
    "# Velocidad desde sonico DT (us/ft) -> m/s\n",
    "# v = 0.3048 / (DT * 1e-6) = 304800 / DT\n",
    "plot_df[\"VEL_FROM_SONIC_MPS\"] = 304800.0 / plot_df[\"SONIC\"]\n",
    "\n",
    "# Tiempo doble TWT (ms): 2 * profundidad / velocidad\n",
    "plot_df[\"TWT_MS\"] = (2.0 * plot_df[\"DEPT\"] / plot_df[\"VEL_FROM_SONIC_MPS\"]) * 1000.0\n",
    "\n",
    "# Filtrar intervalo si se define\n",
    "plot_df = plot_df[(plot_df[\"DEPT\"] >= DEPTH_MIN) & (plot_df[\"DEPT\"] <= DEPTH_MAX)].copy()\n",
    "plot_df = plot_df.sort_values(\"DEPT\")\n",
    "\n",
    "print(f\"Filas en ventana de profundidad: {len(plot_df):,}\")\n",
    "plot_df[[\"DEPT\", \"SONIC\", \"VEL_FROM_SONIC_MPS\", \"TWT_MS\"]].head()"
   ]
  },
