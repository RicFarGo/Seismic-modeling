   "source": [
    "# Legacy cell disabled.\n",
    "\n",
    "# Mantener velocidad desde sonico DT (us/ft) -> m/s\n",
    "resample_df[\"VEL_FROM_SONIC_MPS\"] = 304800.0 / resample_df[\"DT\"]\n",
    "\n",
    "# Mantener muestreo en profundidad por punto\n",
    "resample_df[\"DEPTH_SAMPLING_M\"] = resample_df[\"DEPT\"].shift(-1) - resample_df[\"DEPT\"]\n",
    "\n",
    "# Nuevo log de time sampling (one-way, segundos)\n",
    "resample_df[\"TIME_SAMPLING_SEC\"] = resample_df[\"DEPTH_SAMPLING_M\"] / resample_df[\"VEL_FROM_SONIC_MPS\"]\n",
    "\n",
    "# Pasar a TWT en milisegundos (factor 2 confirmado)\n",
    "resample_df[\"TWT_SAMPLING_MS\"] = 2.0 * resample_df[\"TIME_SAMPLING_SEC\"] * 1000.0\n",
    "\n",
    "# TWT acumulado por muestra (util para eje temporal por traza)\n",
    "valid_twt_sampling = resample_df[\"TWT_SAMPLING_MS\"].replace([np.inf, -np.inf], np.nan)\n",
    "resample_df[\"TWT_MS\"] = valid_twt_sampling.fillna(0.0).cumsum()\n",
    "\n",
    "# Media exacta (sin redondeo) ignorando invalidos\n",
    "valid_sampling = valid_twt_sampling[np.isfinite(valid_twt_sampling) & (valid_twt_sampling > 0)]\n",
    "if valid_sampling.empty:\n",
    "    raise ValueError(\"No hay valores validos en TWT_SAMPLING_MS para calcular la media.\")\n",
    "\n",
    "mean_twt_sampling_ms = float(valid_sampling.mean())\n",
    "\n",
    "print(f\"Media de TWT_SAMPLING_MS (paso exacto): {mean_twt_sampling_ms:.6f} ms\")\n",
    "resample_df[[\"DEPT\", \"DEPTH_SAMPLING_M\", \"DT\", \"VEL_FROM_SONIC_MPS\", \"TIME_SAMPLING_SEC\", \"TWT_SAMPLING_MS\"]].head()"
   ]
  },
