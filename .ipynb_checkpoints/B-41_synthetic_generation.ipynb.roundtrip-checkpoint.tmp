   "source": [
    "# Legacy cell disabled.\n",
    "twt_min = float(valid_twt.min())\n",
    "twt_max = float(valid_twt.max())\n",
    "\n",
    "dt_regular_ms = mean_twt_sampling_ms\n",
    "twt_grid = np.arange(twt_min, twt_max + dt_regular_ms, dt_regular_ms)\n",
    "\n",
    "# Remuestreo por media para todas las columnas numericas\n",
    "numeric_cols = resample_df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "work = resample_df[np.isfinite(resample_df[\"TWT_MS\"])].copy()\n",
    "work[\"BIN_ID\"] = np.floor((work[\"TWT_MS\"] - twt_min) / dt_regular_ms).astype(int)\n",
    "\n",
    "agg = work.groupby(\"BIN_ID\", as_index=False)[numeric_cols].mean()\n",
    "\n",
    "resampled_logs_twt = pd.DataFrame({\n",
    "    \"BIN_ID\": np.arange(len(twt_grid), dtype=int),\n",
    "    \"TWT_MS_REG\": twt_grid,\n",
    "})\n",
    "resampled_logs_twt = resampled_logs_twt.merge(agg, on=\"BIN_ID\", how=\"left\")\n",
    "\n",
    "# TWT regular como columna principal\n",
    "cols = [\"TWT_MS_REG\"] + [c for c in resampled_logs_twt.columns if c not in [\"TWT_MS_REG\", \"BIN_ID\"]]\n",
    "resampled_logs_twt = resampled_logs_twt[cols]\n",
    "\n",
    "print(f\"Paso regular exacto usado: {dt_regular_ms:.6f} ms\")\n",
    "print(f\"Muestras originales: {len(resample_df):,}\")\n",
    "print(f\"Muestras remuestreadas (TWT regular): {len(resampled_logs_twt):,}\")\n",
    "print(f\"Columnas numericas remuestreadas: {len(numeric_cols)}\")\n",
    "\n",
    "resampled_logs_twt[[\"TWT_MS_REG\", \"DEPT\", \"DT\", \"GR\", \"RHOB\", \"TIME_SAMPLING_SEC\", \"TWT_SAMPLING_MS\"]].head()"
   ]
  },
