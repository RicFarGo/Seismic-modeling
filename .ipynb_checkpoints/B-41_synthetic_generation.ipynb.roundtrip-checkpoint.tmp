    "# Legacy cell disabled.\n",
    "plot_ai_rc = resampled_logs_twt.copy()\n",
    "\n",
    "# Track IA\n",
    "axes[0].plot(plot_ai_rc[\"IA\"], plot_ai_rc[\"TWT_MS_REG\"], color=\"purple\", linewidth=1.0)\n",
    "axes[0].set_xlabel(\"IA\", fontsize=12, fontweight=\"bold\")\n",
    "axes[0].set_ylabel(\"TWT (ms)\", fontsize=12)\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Track RC\n",
    "axes[1].plot(plot_ai_rc[\"RC\"], plot_ai_rc[\"TWT_MS_REG\"], color=\"black\", linewidth=1.0)\n",
